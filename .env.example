# Copy to .env (git-ignored) and replace EVERY placeholder. Never commit real values.
# Only needed for the OPTIONAL Docker route (docker-compose.yml) and for the role-setup script variables.
# A native SQL Server install does not need this file for Phase 1.

# Set to Y only after you have read and accepted the SQL Server license terms (Developer edition = dev/test only).
ACCEPT_EULA=

# SQL Server administrator ("sa") password for the optional container. Must meet SQL Server complexity rules.
MSSQL_SA_PASSWORD=change-me-Sa-Passw0rd!

# Migrations/owner login (DDL). Used by the migration step only.
DOUBLEUS_OWNER_PASSWORD=change-me-Owner-Passw0rd!
# Runtime application login: NOT the owner, DML only, so Row-Level Security applies.
DOUBLEUS_APP_PASSWORD=change-me-App-Passw0rd!

REDIS_PASSWORD=change-me-redis
